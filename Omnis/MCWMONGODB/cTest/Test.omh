Do lvoMongoDB.$setconnectionstring("mongodb://the_user:the_password@localhost:27045")
Do lvoMongoDB.$setdatabase("erp")
Do lvoMongoDB.$setcollection("erp_com_001_e_log_trans")
Do lvoMongoDB.$clearfilters()

Do lvoMongoDB.$addfilter("table",kMCWMongoDBOperatorEq,"E_Fac_Doc_Dados_Arm",kMCWMongoDBTypeChar)
Do lvoMongoDB.$addfilter("valueId",kMCWMongoDBOperatorEq,"PRZ/80575692",kMCWMongoDBTypeChar)
Do lvoMongoDB.$addfilter("user",kMCWMongoDBOperatorGte,"100",kMCWMongoDBTypeInteger32)

# Do lvoMongoDB.$setdynamicfilter('{"$or":[{"valueId": "PAG01/2582061"},{"valueId": "PRZ/104880268"}]}')
# Do lvoMongoDB.$setdynamicfilter('{"table": "table_a","details.fieldChanged": {"$in": ["title", "description"]}}')

Do lvoMongoDB.$find(lvLstRegs) Returns lvbOk
If not(lvbOk)
	Do $ctask.$showmessage(lvoMongoDB.$geterrormessage())
Else
	Do $ctask.$showmessage(con(lvLstRegs.$linecount," documents returned."))
End If
Quit method