STRINGTABLE DISCARDABLE 
BEGIN
1000 "MCWMongoDB"

// Object descriptions
2000 "MCWMongoDB:Object for interacting with a MongoDB NoSQL database."

6000 "$setconnectionstring:$setconnectionstring(connectionstring) Sets the connection string."
6001 "$setdatabase:$setdatabase(database) Sets the database name."
6002 "$setcollection:$setcollection(collection) Sets collection name."
6003 "$geterrormessage:$geterrormessage() Returns the error message from the last failed operation."
6004 "$find:$find(documents) Retrieves documents from the collection that match the filter."
6006 "$setfilter:$setfilter(filter) Sets the filter to be used by the find function. Pass an empty string to clear it."
6009 "$setopts:$setopts(opts) Sets additional options (raw JSON, e.g. sort, limit, projection) to be used by the find function."
6010 "$setaggregate:$setaggregate(pipeline) Sets the aggregation pipeline (JSON array of stages) to be used by the aggregate function. Pass an empty string to clear it."
6011 "$aggregate:$aggregate(documents) Executes the aggregation pipeline and retrieves the resulting documents."

// Parameters description
7000 "connectionstring:Connection string used to connect to MongoDB"
7001 "database:Name of the database"
7002 "collection:Name of the collection"
7003 "documents:List of documents returned by MongoDB"
7008 "filter:String containing the filter to apply, in MongoDB query syntax"
7010 "opts:String containing additional find options in MongoDB query syntax (sort, limit, projection, etc.)"
7011 "pipeline:String containing the aggregation pipeline stages, as a MongoDB JSON array of stage documents"

// Constants
19999 "kMCWMongoDB" // Constans prefix

20006 "TypeChar:0:String"
20007 "TypeInteger32:1:32-bit integer"
20008 "TypeInteger64:2:64-bit integer"
20009 "TypeFloat:3:Floating point"
20010 "TypeBoolean:4:Boolean"
20011 "TypeDateTime:5:Date and Time"
20012 "TypeNull:6:Null"

31000 "MCWMongoDBWndProc"
END

